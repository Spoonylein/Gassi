    "ResetSettingsConfirmationMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Rassen, Geschlechter, Kategorien, Unterkategorien und Einstellungen werden gelöscht und beim nächsten Neustart auf Standardwerte zurückgesetzt. Hunde und Ereignisse bleiben erhalten, haben dann jedoch mglw. keine korrekte Zuordnung mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "All breeds, sexes, categories, subtypes, and settings will be deleted and reset to their defaults the next time the app starts. Dogs and events will be preserved, but their assignments may no longer be correct."
          }
        }
      }
    },
    "RestartMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standardwerte werden beim Neustart der App angelegt. Dazu bitte im AppSwitcher die App beenden und dann die App neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Default values will be created when the app restarts. Quit the app from the App Switcher, then open it again."
          }
        }
      }
    },
